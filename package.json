{
  "name": "ar-scan",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "cd server && npm run dev",
    "dev:web": "cd web && npm run dev",
    "build:web": "cd web && npm install && npm run build",
    "build:api": "mkdir -p api && esbuild server/src/api-scan.ts --bundle --platform=node --target=node20 --format=esm --outfile=api/scan.js --external:openai",
    "build": "npm run build:web && npm run build:api",
    "test": "cd server && npm test"
  },
  "dependencies": {
    "openai": "^4.104.0"
  },
  "devDependencies": {
    "@vercel/node": "^5.1.0",
    "esbuild": "^0.25.0"
  }
}
